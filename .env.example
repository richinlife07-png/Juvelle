# Base URL of the backend API.
# In local dev with the Vite proxy (see vite.config.js) you can leave this
# unset and just call "/api/..." from the frontend.
VITE_API_BASE_URL=http://localhost:4000

# Target the Vite dev server proxy forwards /api requests to.
VITE_API_PROXY_TARGET=http://localhost:4000
